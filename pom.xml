<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	  The Spring Boot parent POM. This is where every dependency version in this file comes
	  from - notice that none of the <dependency> blocks below specify a <version>. The parent
	  manages them as a tested-together set, so you can never accidentally pair an incompatible
	  Spring Web with Spring Data. It also configures sensible defaults for the compiler,
	  resource filtering and the surefire test plugin.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath/>
	</parent>

	<groupId>com.inventory</groupId>
	<artifactId>product-service</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>product-service</name>
	<description>Product catalog service for the inventory management system</description>

	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencies>
		<!--
		  A "starter" is not a library - it is a curated bundle of dependencies plus the
		  auto-configuration that wires them up. spring-boot-starter-web pulls in Spring MVC,
		  Jackson (JSON), validation and an embedded Tomcat, then auto-configures a web server
		  on startup simply because it is present on the classpath.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Health, info and metrics endpoints under /actuator. We rely on these heavily
		     later: healthchecks in Docker, circuit-breaker state, Prometheus metrics. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Phase 1: Spring Data JPA. Brings Hibernate (the JPA implementation), the
		     transaction manager, and HikariCP (the connection pool). Adding this is what
		     makes Spring Boot start looking for a DataSource at startup. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Phase 1: Bean Validation (Jakarta Validation + Hibernate Validator). Without
		     this on the classpath, @Valid and @NotBlank are silently ignored - a very common
		     "why isn't my validation running?" bug. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Phase 1: Flyway owns the database schema. It runs the versioned SQL scripts in
		     src/main/resources/db/migration on startup. Since Flyway 10, the Postgres
		     support lives in its own module, so both artifacts are required. -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- Phase 1: the JDBC driver. "runtime" scope because our code never imports it -
		     Hibernate loads it reflectively from the JDBC URL. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Compile-time code generation for getters/setters/constructors. "optional" means
		     it is not passed on to anything that depends on this module. -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- One starter covers JUnit 5, AssertJ, Mockito, MockMvc and Spring's test context. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
		  Deliberately NOT here yet (see docs/ROADMAP.md):
		    Phase 4  spring-cloud-starter-netflix-eureka-client
		    Phase 7  spring-cloud-starter-circuitbreaker-resilience4j
		    Phase 8  spring-boot-starter-amqp
		    Phase 9  micrometer-tracing-bridge-brave, zipkin-reporter-brave

		  Adding data-jpa before there is a database is how you get
		  "Failed to configure a DataSource" on your very first run. Every dependency should
		  answer a problem you have already hit.
		-->
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Lombok is only needed at compile time, so keep it out of the fat jar. -->
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
